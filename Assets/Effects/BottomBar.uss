.hidden { display: none; }

.root{
  width: 100%;
  height: 100%;
}

.game {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 90%;
}

.bottom {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 10%;
    align-items: center;
    flex-direction: row;
}

.bottom .bar {
    width: 30%;
    margin: 0 auto;
    background-color: gray;
}