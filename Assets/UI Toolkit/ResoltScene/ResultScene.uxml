<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/ResoltScene/ResultScene.uss?fileID=7433441132597879392&amp;guid=c7d8cc78101a94b9f93c94e474c98ff5&amp;type=3#ResultScene" />
    <ui:VisualElement name="BackgroundMap" style="position: absolute; top: 0; left: 0; bottom: 0; right: 0; background-color: rgb(255, 255, 255); color: rgb(255, 0, 0); background-image: url(&quot;project://database/Assets/PNG/TutorialMap.png?fileID=2800000&amp;guid=76f018b261fcf41a4918f55ff68dc041&amp;type=3#TutorialMap&quot;);" />
    <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: center;">
        <ui:VisualElement name="ResultPanel" style="flex-grow: 0; flex-shrink: 1; min-width: auto; flex-basis: auto;">
            <ui:Label name="RankLabel" text="RANK: #1" style="font-size: 30px; color: rgb(0, 229, 255);" />
            <ui:Label text="NEW RECORD!" name="NewRecordLabel" emoji-fallback-support="false" focusable="true" style="display: none;" />
            <ui:Label name="TimeLabel" text="TIME: 00:00.000" style="opacity: 1; font-size: 40px;" />
            <ui:VisualElement name="RankingList" style="width: 100%; margin-top: 20px;">
                <ui:VisualElement class="ranking-row header-row">
                    <ui:Label text="POS" class="col-pos" />
                    <ui:Label text="NAME" class="col-name" />
                    <ui:Label text="TIME" class="col-time" />
                </ui:VisualElement>
                <ui:VisualElement class="ranking-row">
                    <ui:Label text="1st" class="col-pos" />
                    <ui:Label text="PLAYER 1" class="col-name" />
                    <ui:Label text="01:20.500" class="col-time" />
                </ui:VisualElement>
                <ui:VisualElement class="ranking-row">
                    <ui:Label text="2nd" class="col-pos" />
                    <ui:Label text="PLAYER 2" class="col-name" />
                    <ui:Label text="01:22.100" class="col-time" />
                </ui:VisualElement>
                <ui:VisualElement class="ranking-row player-highlight">
                    <ui:Label text="3rd" class="col-pos" />
                    <ui:Label text="YOU" class="col-name" />
                    <ui:Label text="01:23.456" class="col-time" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="height: 2px; background-color: rgba(255, 255, 255, 0.1); margin: 20px 0; width: 100%;" />
            <ui:Button name="ReturnButton" text="RETURN TO MENU" class="button-primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
