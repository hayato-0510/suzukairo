/* 実況テキストのスタイル */
.commentary-text {
    font-size: 24px;
    color: #ffffff;
    /* -unity-font-style: bold; 太字データがない場合のフォールバック回避のため削除 */
    background-color: rgba(0, 0, 0, 0.7);
    padding: 10px 30px;
    border-radius: 20px;
    border-width: 2px;
    border-color: #ff0055; /* アクセントカラー */
    -unity-text-align: middle-center;
    max-width: 80%;
}

/* アニメーション用のクラス（C#側でトグルする想定） */
.commentary-visible {
    opacity: 1;
    translate: 0 0;
}

.commentary-hidden {
    opacity: 0;
    translate: 0 -50px; /* 上に隠れる */
}
